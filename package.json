{
  "name": "fenbi-tools",
  "displayName": "Fenbi Tools",
  "description": "粉笔考公&摸鱼学习、考公必备，支持自定义数量、刷题历史、申论等功能",
  "icon": "resources/dark/fish.png",
  "version": "1.0.33",
  "license": "ISC",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "摸鱼",
    "fish",
    "学习",
    "考公",
    "公务员",
    "做题"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fenbiBar",
          "title": "fenbi",
          "icon": "resources/dark/fenbi.svg"
        }
      ]
    },
    "views": {
      "fenbiBar": [
        {
          "type": "webview",
          "id": "openFenbiWebview",
          "name": "container"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.openWebview",
        "title": "Open Webview"
      },
      {
        "command": "openFenbiWebview.refreshEntry",
        "title": "刷新",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openFenbiWebview.refreshEntry",
          "group": "navigation",
          "when": "view == openFenbiWebview"
        }
      ]
    },
    "configuration": {
      "title": "FenbiTools",
      "properties": {
        "fenbiTools.cookie": {
          "type": "string",
          "default": "",
          "markdownDescription": "cookie，必填，请修改后刷新",
          "editPresentation": "multilineText"
        },
        "fenbiTools.color": {
          "type": "string",
          "default": "#ffffff",
          "markdownDescription": "自定义字体color颜色，请填写色值，非中文！请修改后刷新"
        },
        "fenbiTools.backgroundColor": {
          "type": "string",
          "default": "#21222b",
          "markdownDescription": "自定义背景bgColor颜色，请填写色值，非中文！请修改后刷新"
        },
        "fenbiTools.needLineThrough": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "开启后，选项后会增加排除按钮，点击即可给当前选项增加中划线"
        },
        "fenbiTools.fontSize": {
          "type": "number",
          "default": 12,
          "markdownDescription": "自定义字体大小（单位px），默认12，请修改后刷新"
        },
        "fenbiTools.correctColor": {
          "type": "string",
          "default": "#30c9a1",
          "markdownDescription": "自定义解答页正确答案颜色，请填写色值"
        },
        "fenbiTools.wrongColor": {
          "type": "string",
          "default": "#ff4d4f",
          "markdownDescription": "自定义解答页错误答案颜色，请填写色值"
        },
        "fenbiTools.buttonBorderColor": {
          "type": "string",
          "default": "#ffffff",
          "markdownDescription": "自定义按钮、Card 和解析虚线框边框颜色，请填写色值"
        },
        "fenbiTools.canvasBrushColor": {
          "type": "string",
          "default": "red",
          "markdownDescription": "画板默认画笔颜色，例如 red 或 #ff0000"
        },
        "fenbiTools.canvasBrushWidth": {
          "type": "number",
          "default": 3,
          "markdownDescription": "画板默认画笔粗细（单位px）"
        }
      }
    }
  },
  "scripts": {
    "watch": "npm-run-all -p watch:*",
    "watch:extension": "tsc -watch -p ./",
    "watch:views": "webpack --watch --mode development",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./out/test/runTest.js",
    "package": "npm run compile && vsce package",
    "build": "npm run compile && vsce package",
    "publish": "vsce publish",
    "compile": "npm-run-all compile:*",
    "compile:extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile:views": "webpack --mode production"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/qs": "^6.9.16",
    "babel-loader": "^10.0.0",
    "babel-plugin-import": "^1.13.8",
    "css-loader": "^6.8.1",
    "esbuild": "^0.19.5",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "gulp": "^5.0.0",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "mocha": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "typescript": "^4.9.3",
    "webpack-bundle-analyzer": "^5.0.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.10.1",
    "cheerio": "^1.0.0-rc.12",
    "dayjs": "^1.11.13",
    "qs": "^6.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Mrxiiaobai/fenbi-tools.git"
  },
  "publisher": "mrsavior",
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "echo \"[Husky] pre-commit\"",
      "commit-msg": "commitlint",
      "pre-push": "npm run changelog"
    }
  }
}